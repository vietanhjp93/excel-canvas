    "keywords": [
        "react",
        "datagrid",
        "data-grid",
        "editor",
        "reactjs",
        "scrolling",
        "data",
        "table",
        "cell",
        "canvas"
    ],
    "dependencies": {
        "excel-canvas": "1.1.18"
    },
    "peerDependencies": {
        "lodash": "^4.17.19",
        "react": "^16.12.0 || 17.x || 18.x || 19.x",
        "react-dom": "^16.12.0 || 17.x || 18.x || 19.x"
    },
    "devDependencies": {
        "@babel/cli": "^7.27.2",
        "eslint": "^8.57.1",
        "eslint-plugin-import": "^2.31.0",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-hooks": "^5.2.0",
        "react-resize-detector": "^12.1.0",
        "tsc-esm-fix": "^3.1.2"
    }
