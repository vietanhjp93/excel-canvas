        "test": "vitest"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/vietanhjp93/glide-data-grid.git"
    },
    "homepage": "https://github.com/vietanhjp93/glide-data-grid",
    "author": "vietanhjp93",
